diff --git a/Tests/NorseHorsePGPCoreTests/V4ConformanceTests.swift b/Tests/NorseHorsePGPCoreTests/V4ConformanceTests.swift
index 4e85526..6e67fe5 100644
--- a/Tests/NorseHorsePGPCoreTests/V4ConformanceTests.swift
+++ b/Tests/NorseHorsePGPCoreTests/V4ConformanceTests.swift
@@ -80,4 +80,23 @@ final class V4ConformanceTests: XCTestCase {
         XCTAssertTrue(sig.contains("END PGP SIGNATURE"))
     }
 
+    // Disposable GnuPG-generated test key; the private key is public test data.
+    func testProtectedV4KeyReportsUnlockFailuresAndRoundTrips() throws {
+        let secret = Data(base64Encoded: "")!
+        XCTAssertThrowsError(try OpenPGPPacketParser.cv25519DecryptionKey(fromSecretKey: secret, passphrase: nil)) { error in
+            guard case PacketParserError.passphraseRequired = error else { return XCTFail("Expected passphraseRequired: \(error)") }
+        }
+        XCTAssertThrowsError(try OpenPGPPacketParser.cv25519DecryptionKey(fromSecretKey: secret, passphrase: "wrong")) { error in
+            guard case PacketParserError.wrongPassphrase = error else { return XCTFail("Expected wrongPassphrase: \(error)") }
+        }
+        let privateKey = try OpenPGPPacketParser.cv25519DecryptionKey(fromSecretKey: secret, passphrase: "fixture-only")
+        let armored = try OpenPGPPacketParser.transferablePublicKey(fromSecretKey: secret)
+        let publicKey = try OpenPGPPacketParser.dearmor(armored)
+        let recipient = try OpenPGPPacketParser.cv25519Recipient(fromPublicKey: publicKey)
+        let message = Data("protected GPG fixture".utf8)
+        let encrypted = try OpenPGPPacketBuilder.buildEncryptedMessage(plaintext: message, recipients: [recipient], armor: false)
+        let decrypted = try OpenPGPPacketParser.decryptMessageReturningInnerPackets(messageData: encrypted, decryptionKeys: [privateKey])
+        XCTAssertEqual(decrypted.literalData, message)
+    }
+
 }
