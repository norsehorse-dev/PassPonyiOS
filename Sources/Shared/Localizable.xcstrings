    "This isn't an otpauth:// one-time code link. Counter-based (HOTP) codes and Google Authenticator export codes aren't supported.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist kein otpauth://-Link für einen Einmalcode. Zählerbasierte Codes (HOTP) und Google-Authenticator-Exportcodes werden nicht unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no es un enlace otpauth:// de código de un solo uso. No se admiten códigos basados en contador (HOTP) ni códigos de exportación de Google Authenticator."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci n'est pas un lien otpauth:// de code à usage unique. Les codes à compteur (HOTP) et les codes d'exportation Google Authenticator ne sont pas pris en charge."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto não é um link otpauth:// de código de uso único. Códigos baseados em contador (HOTP) e códigos de exportação do Google Authenticator não são suportados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не ссылка otpauth:// на одноразовый код. Коды на основе счётчика (HOTP) и коды экспорта Google Authenticator не поддерживаются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是 otpauth:// 一次性验证码链接。不支持基于计数器的 (HOTP) 验证码和 Google Authenticator 导出码。"
          }
        }
      }
    },
    "This report has no entry names, secrets, key fingerprints, or remote credentials. Paste it into a support message or a GitHub issue.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Bericht enthält keine Eintragsnamen, Geheimnisse, Schlüssel-Fingerabdrücke oder Remote-Zugangsdaten. Füge ihn in eine Support-Nachricht oder ein GitHub-Issue ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este informe no contiene nombres de entradas, secretos, huellas de claves ni credenciales del remoto. Pégalo en un mensaje de soporte o en un issue de GitHub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce rapport ne contient aucun nom d'entrée, secret, empreinte de clé ni identifiant distant. Collez-le dans un message au support ou dans un ticket GitHub."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este relatório não contém nomes de entradas, segredos, impressões digitais de chaves nem credenciais do remoto. Cole-o em uma mensagem de suporte ou em uma issue do GitHub."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом отчёте нет имён записей, секретов, отпечатков ключей и учётных данных удалённого репозитория. Вставьте его в сообщение в поддержку или в issue на GitHub."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此报告不包含条目名称、机密、密钥指纹或远程凭据。可将其粘贴到支持消息或 GitHub issue 中。"
          }
        }
      }
    },
