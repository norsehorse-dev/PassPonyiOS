    "Git hosts that only know this key will stop accepting this app. A backup made after the key was set up still has a copy." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git-Hosts, die nur diesen Schlüssel kennen, akzeptieren diese App dann nicht mehr. Ein Backup, das nach dem Einrichten des Schlüssels erstellt wurde, enthält weiterhin eine Kopie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
