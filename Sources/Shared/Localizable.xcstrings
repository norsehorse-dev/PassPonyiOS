          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключи не импортированы. Хранилищу pass нужен как минимум открытый ключ, соответствующий его .gpg-id (и секретный ключ для расшифровки)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
