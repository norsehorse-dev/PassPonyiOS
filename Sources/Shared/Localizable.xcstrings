      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Schlüssel importiert. Ein pass-Speicher braucht mindestens einen öffentlichen Schlüssel passend zu seiner .gpg-id (und den geheimen Schlüssel zum Entschlüsseln)."
          }
        },
        "es": {
          "stringUnit": {
