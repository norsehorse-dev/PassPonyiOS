    "PassPony locks behind Face ID, Touch ID, or your passcode.\n\nAfter you unlock, it stays open for %lld minutes (shared with autofill), then locks again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "PassPony ist hinter Face ID, Touch ID oder deinem Code gesperrt.\n\nNach dem Entsperren bleibt es %lld Minute offen (mit AutoFill geteilt) und sperrt sich dann wieder."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "PassPony ist hinter Face ID, Touch ID oder deinem Code gesperrt.\n\nNach dem Entsperren bleibt es %lld Minuten offen (mit AutoFill geteilt) und sperrt sich dann wieder."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "PassPony locks behind Face ID, Touch ID, or your passcode.\n\nAfter you unlock, it stays open for %lld minute (shared with autofill), then locks again."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "PassPony locks behind Face ID, Touch ID, or your passcode.\n\nAfter you unlock, it stays open for %lld minutes (shared with autofill), then locks again."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "PassPony se bloquea con Face ID, Touch ID o tu código.\n\nDespués de desbloquear, permanece abierto durante %lld minuto (compartido con el autorrelleno) y luego se vuelve a bloquear."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "PassPony se bloquea con Face ID, Touch ID o tu código.\n\nDespués de desbloquear, permanece abierto durante %lld minutos (compartido con el autorrelleno) y luego se vuelve a bloquear."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "PassPony se verrouille derrière Face ID, Touch ID ou votre code.\n\nAprès déverrouillage, il reste ouvert pendant %lld minute (partagé avec le remplissage automatique), puis se verrouille à nouveau."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "PassPony se verrouille derrière Face ID, Touch ID ou votre code.\n\nAprès déverrouillage, il reste ouvert pendant %lld minutes (partagé avec le remplissage automatique), puis se verrouille à nouveau."
                }
              }
            }
          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "O PassPony fica bloqueado por Face ID, Touch ID ou seu código.\n\nDepois de desbloquear, ele permanece aberto por %lld minuto (compartilhado com o preenchimento automático) e depois bloqueia novamente."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "O PassPony fica bloqueado por Face ID, Touch ID ou seu código.\n\nDepois de desbloquear, ele permanece aberto por %lld minutos (compartilhado com o preenchimento automático) e depois bloqueia novamente."
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "PassPony блокируется с помощью Face ID, Touch ID или код-пароля.\n\nПосле разблокировки он остаётся открытым %lld минуты (совместно с автозаполнением), затем снова блокируется."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "PassPony блокируется с помощью Face ID, Touch ID или код-пароля.\n\nПосле разблокировки он остаётся открытым %lld минут (совместно с автозаполнением), затем снова блокируется."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "PassPony блокируется с помощью Face ID, Touch ID или код-пароля.\n\nПосле разблокировки он остаётся открытым %lld минуту (совместно с автозаполнением), затем снова блокируется."
                }
