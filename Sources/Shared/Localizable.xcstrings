    "Every entry in scope is decrypted and re-encrypted to the recipients its directory currently resolves to.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Eintrag im Bereich wird entschlüsselt und für die Empfänger neu verschlüsselt, die sein Verzeichnis aktuell auflöst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada entrada dentro del ámbito se descifra y se vuelve a cifrar para los destinatarios que su directorio resuelve actualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque entrée dans la portée est déchiffrée puis rechiffrée pour les destinataires que son dossier résout actuellement."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada entrada no escopo é descriptografada e recriptografada para os destinatários que seu diretório resolve atualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая запись в выбранной области расшифровывается и заново шифруется для получателей, которых сейчас определяет её каталог."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "范围内的每个条目都会被解密，并为其目录当前解析到的接收者重新加密。"
          }
        }
      }
    },
