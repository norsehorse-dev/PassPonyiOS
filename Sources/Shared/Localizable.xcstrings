          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada código consume un valor del contador y se guarda en la entrada, igual que pass otp code."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque code consomme une valeur du compteur et est enregistré dans l'entrée, comme avec pass otp code."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada código consome um valor do contador e é salvo na entrada, assim como no pass otp code."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый код расходует одно значение счётчика и сохраняется в записи, так же как pass otp code."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
