    "Paste the otpauth:// link the site offers during two-factor setup, or the output of pass otp uri on your desktop.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze den otpauth://-Link ein, den die Website bei der Einrichtung der Zwei-Faktor-Authentifizierung anbietet, oder die Ausgabe von pass otp uri auf deinem Rechner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
