    "Commits the current store and pushes it to an empty remote. SSH remotes land with the SSH-auth work; use HTTPS with a token for now.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Committet den aktuellen Speicher und pusht ihn zu einem leeren Remote. SSH-Remotes kommen mit der SSH-Auth-Arbeit; nutze vorerst HTTPS mit einem Token."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma el almacén actual y lo envía a un remoto vacío. Los remotos SSH llegarán con el trabajo de autenticación SSH; por ahora usa HTTPS con un token."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Committe le coffre actuel et le pousse vers un dépôt distant vide. Les distants SSH arriveront avec l'authentification SSH ; utilisez HTTPS avec un jeton pour l'instant."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz commit do cofre atual e o envia para um remoto vazio. Remotos SSH chegarão com o trabalho de autenticação SSH; por enquanto use HTTPS com um token."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коммитит текущее хранилище и отправляет его в пустой удалённый репозиторий. Поддержка SSH появится вместе с SSH-аутентификацией; пока используйте HTTPS с токеном."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交当前密码库并推送到一个空的远程仓库。SSH 远程将随 SSH 认证功能一起推出；目前请使用带令牌的 HTTPS。"
          }
        }
      }
    },
