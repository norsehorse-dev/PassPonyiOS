    "Each format keeps its own store. Switching never touches the other store's data.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Format hat seinen eigenen Speicher. Ein Wechsel rührt die Daten des anderen Speichers nie an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada formato mantiene su propio almacén. Cambiar nunca toca los datos del otro almacén."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque format garde son propre coffre. Changer ne touche jamais aux données de l'autre coffre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada formato mantém seu próprio cofre. Alternar nunca toca nos dados do outro cofre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждого формата своё хранилище. Переключение никогда не затрагивает данные другого хранилища."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每种格式都有自己的密码库。切换永远不会影响另一个密码库的数据。"
