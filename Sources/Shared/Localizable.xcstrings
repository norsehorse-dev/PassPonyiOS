          "stringUnit" : {
            "state" : "translated",
            "value" : "Der SSH-Host hat den Schlüssel von PassPony nicht akzeptiert. Prüfe, ob der zugehörige öffentliche Schlüssel deinem Konto auf dem Host hinzugefügt wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor SSH no aceptó la clave de PassPony. Comprueba que su clave pública esté añadida a tu cuenta en el servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'hôte SSH n'a pas accepté la clé de PassPony. Vérifiez que sa clé publique est ajoutée à votre compte sur l'hôte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O host SSH não aceitou a chave do PassPony. Verifique se a chave pública do PassPony foi adicionada à sua conta no host."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
