                "stringUnit": {
                  "state": "translated",
                  "value": "У вас уже %lld записей"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "У вас уже %lld запись"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "У вас уже %lld записей"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "你已有 %lld 个条目"
                }
