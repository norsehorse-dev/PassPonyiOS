    "pass (OpenPGP)" : {
      "extractionState" : "manual",
      "shouldTranslate" : false
    },
    "passage (age)" : {
      "extractionState" : "manual",
      "shouldTranslate" : false
    },
    "passage encrypts with modern age identities. pass encrypts with OpenPGP keys and works with existing pass stores.\n\nEach format keeps its own store, and you can switch anytime in Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "passage verschlüsselt mit modernen age-Identitäten. pass verschlüsselt mit OpenPGP-Schlüsseln und funktioniert mit vorhandenen pass-Speichern.\n\nJedes Format hat seinen eigenen Speicher, und du kannst jederzeit in den Einstellungen wechseln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "passage cifra con identidades age modernas. pass cifra con claves OpenPGP y funciona con almacenes de pass existentes.\n\nCada formato mantiene su propio almacén y puedes cambiar en cualquier momento en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "passage chiffre avec des identités age modernes. pass chiffre avec des clés OpenPGP et fonctionne avec les coffres pass existants.\n\nChaque format garde son propre coffre, et vous pouvez changer à tout moment dans Réglages."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O passage criptografa com identidades age modernas. O pass criptografa com chaves OpenPGP e funciona com cofres pass existentes.\n\nCada formato mantém seu próprio cofre, e você pode trocar a qualquer momento em Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "passage шифрует современными идентификаторами age. pass шифрует ключами OpenPGP и работает с существующими хранилищами pass.\n\nУ каждого формата своё хранилище, переключиться можно в любой момент в настройках."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "passage 使用现代的 age 身份加密。pass 使用 OpenPGP 密钥加密，并兼容现有的 pass 密码库。\n\n每种格式都有自己的密码库，之后随时可以在“设置”中切换。"
          }
        }
      }
    },
