    "%lld to %lld characters. The slider stops at 64; type a larger number for more.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld bis %2$lld Zeichen. Der Regler endet bei 64; für mehr gib eine größere Zahl ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De %1$lld a %2$lld caracteres. El control deslizante llega hasta 64; escribe un número mayor para más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De %1$lld à %2$lld caractères. Le curseur s'arrête à 64 ; saisissez un nombre plus grand pour aller au-delà."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De %1$lld a %2$lld caracteres. O controle deslizante para em 64; digite um número maior para mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От %1$lld до %2$lld символов. Ползунок ограничен 64; для большего введите число вручную."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 到 %2$lld 个字符。滑块最大为 64；如需更多，请输入更大的数字。"
          }
        }
      }
    },
