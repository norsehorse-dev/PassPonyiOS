    "PassPony can save and use passkeys in your browser. Turn it on as a passkey provider in Passwords & accounts." : {
      "comment" : "Android only. Settings text. 'Passwords & accounts' is the name of the Android system settings screen; use the name Android uses in this language if you know it, otherwise translate naturally.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PassPony kann Passkeys in deinem Browser sichern und verwenden. Aktiviere PassPony unter „Passwörter und Konten“ als Passkey-Anbieter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PassPony puede guardar y usar llaves de acceso en tu navegador. Actívalo como proveedor de llaves de acceso en Contraseñas y cuentas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PassPony peut enregistrer et utiliser des clés d'accès dans votre navigateur. Activez-le comme fournisseur de clés d'accès dans Mots de passe et comptes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O PassPony pode salvar e usar chaves de acesso no seu navegador. Ative-o como provedor de chaves de acesso em Senhas e contas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PassPony может сохранять и использовать ключи доступа в браузере. Включите PassPony как сервис ключей доступа в разделе «Пароли и аккаунты»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PassPony 可以在浏览器中保存和使用通行密钥。请在“密码和帐号”中将其开启为通行密钥提供程序。"
          }
        }
      }
    },
    "PassPony doesn't support %@ SSH keys. Use an Ed25519, RSA or ECDSA key." : {
