    "Anyone who gets this file can read your passage entries. Keep it somewhere only you can reach, or use the encrypted backup instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder, der diese Datei bekommt, kann deine passage-Einträge lesen. Bewahre sie an einem Ort auf, auf den nur du Zugriff hast, oder nutze stattdessen das verschlüsselte Backup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera que consiga este archivo podrá leer tus entradas de passage. Guárdalo en un lugar al que solo tú tengas acceso, o usa la copia de seguridad cifrada en su lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quiconque obtient ce fichier peut lire vos entrées passage. Conservez-le dans un endroit accessible à vous seul, ou utilisez plutôt la sauvegarde chiffrée."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer pessoa que obtiver este arquivo poderá ler suas entradas do passage. Guarde-o em um lugar que só você possa acessar ou use o backup criptografado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любой, кто получит этот файл, сможет прочитать ваши записи passage. Храните его там, где доступ есть только у вас, или используйте вместо этого зашифрованную резервную копию."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何拿到此文件的人都能读取你的 passage 条目。请将它存放在只有你能访问的地方，或改用加密备份。"
          }
        }
      }
    },
